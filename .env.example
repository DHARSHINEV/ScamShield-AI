# ScamShield AI Environment Configuration

# Server Settings
PROJECT_NAME="ScamShield AI"
ENVIRONMENT="production"
DEBUG=false
API_PREFIX="/api"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Optional AI LLM Provider ("openai", "gemini", or "local")
# If empty, the system operates completely on local deterministic rules and scikit-learn ML models.
LLM_PROVIDER="local"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Classification Thresholds
SAFE_THRESHOLD=0.35
SUSPICIOUS_THRESHOLD=0.70

# Fusion Weights
WEIGHT_RULES=0.35
WEIGHT_URL=0.30
WEIGHT_ML=0.35
WEIGHT_SEMANTIC_AI=0.0
